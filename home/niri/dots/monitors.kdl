// One block per host. niri ignores blocks whose output is not connected,
// so this file is shared verbatim by both machines. Names must match
// `monitor` in hosts/<name>/vars.nix; confirm with `niri msg outputs`.
// Caveat: "DP-1" is a connector name, so a DisplayPort screen docked to
// think-pad would pick up the game-box block. Switch that block to the
// "Make Model Serial" form if that ever happens.

// think-pad — built-in panel. Preferred mode (1920x1200@60.026) is the default.
output "eDP-1" {
    scale 1.25
}

// game-box — Dell AW2518H. EDID prefers 60 Hz, so the mode must be explicit.
output "DP-1" {
    scale 1
    mode "1920x1080@240.000"
    variable-refresh-rate on-demand=true
}
