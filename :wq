{ config, pkgs, lib, vars, ... }: 
{
  imports = [
    ./hyprland/default.nix
    ./shell/default.nix
    ./desktop-entries.nix
    ./git.nix
    ./gtk.nix
    ./packages.nix
    ./ssh.nix
    ./nvim.nix
    ./tex.nix
    ./tmux.nix
    ./tui.nix
    ./yazi.nix
  ];

  home = {
    username = vars.username;
    homeDirectory = "/home/${vars.username}";
    stateVersion = "26.05";
  };
  
  # Enable Home Manager
  programs.home-manager.enable = true;
}
